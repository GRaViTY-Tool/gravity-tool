Manifest-Version: 1.0
Bundle-SymbolicName: org.gravity.modisco;singleton:=true
Require-Bundle: org.eclipse.emf.ecore.xmi,
 org.eclipse.core.runtime,
 org.eclipse.emf.ecore;visibility:=reexport,
 org.eclipse.modisco.java;visibility:=reexport,
 org.eclipse.modisco.infra.discovery.core;visibility:=reexport,
 org.eclipse.modisco.java.discoverer,
 org.gravity.eclipse,
 org.eclipse.modisco.java.generation,
 org.apache.log4j,
 org.moflon.tgg.runtime,
 org.moflon.tgg.language,
 org.apache.xmlgraphics
Import-Package: guru.nidi.graphviz.attribute,
 guru.nidi.graphviz.engine,
 guru.nidi.graphviz.model
Bundle-ManifestVersion: 2
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Bundle-Vendor: %providerName
Export-Package: org.gravity.modisco,
 org.gravity.modisco.bugfixes,
 org.gravity.modisco.codegen,
 org.gravity.modisco.discovery,
 org.gravity.modisco.impl,
 org.gravity.modisco.processing,
 org.gravity.modisco.processing.fwd,
 org.gravity.modisco.processing.fwd.dataflow,
 org.gravity.modisco.util
Bundle-Name: %pluginName
Bundle-Version: 1.0.0.qualifier
Bundle-Localization: plugin
Bundle-Activator: org.gravity.modisco.GravityMoDiscoActivator
Automatic-Module-Name: org.gravity.modisco
Bundle-ClassPath: .
