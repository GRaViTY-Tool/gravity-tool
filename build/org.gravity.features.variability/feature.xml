<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="org.gravity.features.variability"
      label="GRaViTY Variability Support"
      version="1.0.0.qualifier"
      provider-name="University of Koblenz-Landau"
      license-feature="org.gravity.license.epl"
      license-feature-version="1.0.0.qualifier">

   <description url="https://www.gravity-tool.org">
      Variability-aware Java and type-graph support for software product lines.
   </description>

   <copyright>
      (C) Copyright ${year} University of Koblenz-Landau, Technische Universität Darmstadt, and Ruhr University Bochum
   </copyright>

   <url>
      <discovery label="Henshin MultiVar" url="https://gravity-tool.org/henshin-multivar/updatesite"/>
   </url>

   <includes
         id="org.gravity.license.epl"
         version="0.0.0"/>

   <requires>
      <!-- MoDisco already aggregates the Eclipse and type-graph base features. -->
      <import feature="org.gravity.features.modisco"/>
      <import feature="de.ovgu.featureide"/>
      <import feature="org.eclipse.emf.henshin.sdk"/>
   </requires>

   <plugin
         id="org.gravity.eclipse.java.spl"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.gravity.typegraph.spl"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

</feature>
